# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-ssr/
*.local

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Shippable artefacts.
#
# program/{macos,windows}/ is where finished builds are collected. The bundles
# themselves stay out of git -- one macOS build is ~57 MB and a fresh copy would
# land on every rebuild -- but the folders and their READMEs are tracked, so the
# structure and the instructions survive a clean checkout even when the binaries
# do not.
program/*/*
!program/*/README.md

# Icons generated by `pnpm tauri icon`. icon.icns is required for the macOS
# bundle and is deliberately uncommitted (see program/macos/README.md); the rest
# are iOS, Android and Windows Store sets this project does not ship.
src-tauri/icons/icon.icns
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/64x64.png
src-tauri/icons/Square*Logo.png
src-tauri/icons/StoreLogo.png

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local secrets — API keys live in the Windows Credential Manager, never on disk,
# but keep this here so a stray .env can't be committed by accident.
.env
.env.*
!.env.example

# Demo build output
dist-demo/
demo-standalone.html
