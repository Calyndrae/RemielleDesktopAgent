{
  "name": "remielle-desktop-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A desktop companion agent featuring Remielle Dan \u2014 floating mascot with an LLM chat panel.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "layout:check": "node scripts/layout-check.mjs",
    "harness": "vite --open /harness.html",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "demo": "vite --open /demo.html",
    "demo:build": "vite build --config vite.demo.config.ts && node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "framer-motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
